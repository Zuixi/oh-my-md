{
  "name": "oh-my-md",
  "private": true,
  "version": "0.1.6",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/task.mjs dev",
    "dev:web": "node scripts/task.mjs dev web",
    "build": "node scripts/task.mjs build",
    "build:web": "node scripts/task.mjs build web",
    "test": "node scripts/task.mjs test",
    "test:quality": "node --test scripts/check-module-size.test.mjs scripts/task.test.mjs",
    "test:engine": "node scripts/task.mjs test engine",
    "test:desktop": "node scripts/task.mjs test desktop",
    "test:e2e": "node scripts/task.mjs test e2e",
    "test:rust": "node scripts/task.mjs test rust",
    "check:modules": "node scripts/check-module-size.mjs",
    "check:quality": "pnpm check:modules && pnpm test:quality",
    "check:perf": "pnpm --filter @omd/engine perf:gate",
    "verify": "node scripts/task.mjs verify",
    "verify:win": "powershell -ExecutionPolicy Bypass -File scripts/test.ps1 && powershell -ExecutionPolicy Bypass -File scripts/build.ps1",
    "verify:unix": "bash scripts/test.sh && bash scripts/build.sh",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "release:version": "bash scripts/sync-version.sh",
    "release:changelog": "bash scripts/changelog.sh",
    "package": "node scripts/task.mjs package",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "prepare": "git config core.hooksPath .githooks"
  }
}
