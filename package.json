{
  "name": "oh-my-md",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @omd/desktop tauri dev",
    "test": "pnpm --filter @omd/engine test",
    "verify": "bash scripts/test.sh && bash scripts/build.sh",
    "release:version": "bash scripts/sync-version.sh",
    "release:changelog": "bash scripts/changelog.sh",
    "prepare": "git config core.hooksPath .githooks"
  }
}
